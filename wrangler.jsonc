{
  // 纯静态部署：刻意不写 main 字段，不挂 Worker 脚本。
  // 所有请求直接命中静态资源，按 Cloudflare 计费规则属于
  // "Requests to static assets are free and unlimited"，不消耗 CPU 配额。
  //
  // assets.directory 必须指向独立的 dist/，不能指向项目根：
  // Wrangler 在根目录模式下不读 .assetsignore，会把 .git 一起上传。
  // 部署前先执行 npm run build 生成 dist/。
  "name": "epubify",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./dist"
  }
}
